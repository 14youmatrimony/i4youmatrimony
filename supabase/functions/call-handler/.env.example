# ============================================================================
# Supabase Edge Functions Secrets for Call Push Notifications
# ============================================================================

# --- Supabase Default Secrets (Injected automatically in production) ---
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJh...

# --- Firebase Cloud Messaging (FCM HTTP v1) ---
# Download your Service Account JSON from:
# Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FCM_PROJECT_ID="your-firebase-project-id"
FCM_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com"
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# --- Apple Push Notification service (APNs VoIP / PushKit) ---
# Generate a .p8 key from:
# Apple Developer Portal -> Certificates, Identifiers & Profiles -> Keys -> Create Key (check APNs)
APNS_KEY_ID="ABC1234XYZ"
APNS_TEAM_ID="DEF5678UVW"
APNS_BUNDLE_ID="com.i4you.matrimony"
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGTAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBHkwdwIBAQQg...\n-----END PRIVATE KEY-----\n"
APNS_PRODUCTION="false" # "false" for Sandbox (Xcode debug builds), "true" for TestFlight / App Store
