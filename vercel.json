{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "buildCommand": "vite build",
  "installCommand": "npm install",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/:match*",
      "destination": "/admin.html"
    },
    {
      "source": "/((?!admin|assets|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
