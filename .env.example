# Aadhaar eKYC Providers (Choose Sandbox.co.in or Surepass)
# Sandbox.co.in (https://sandbox.co.in)
VITE_SANDBOX_API_KEY=your_sandbox_api_key_here
VITE_SANDBOX_API_SECRET=your_sandbox_api_secret_here

# Surepass.io (https://surepass.io)
VITE_SUREPASS_API_TOKEN=your_surepass_token_here

# Cloudflare R2 Storage Configuration (High-Performance Photo Storage)
# Found in Cloudflare Dashboard -> R2 -> Manage R2 API Tokens & Bucket Settings
VITE_R2_ENDPOINT=https://<your_account_id>.r2.cloudflarestorage.com
VITE_R2_ACCESS_KEY_ID=your_r2_access_key_id
VITE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
VITE_R2_BUCKET_NAME=your_r2_bucket_name
VITE_R2_PUBLIC_URL=https://pub-<your_public_hash>.r2.dev

